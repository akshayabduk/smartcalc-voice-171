<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme (Light) -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/colorPrimary</item>
        <item name="android:colorAccent">@color/colorAccent</item>
        <item name="android:textColorPrimary">@color/onSurface_light</item>
        <item name="android:windowBackground">@color/surface_light</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Dark theme -->
    <style name="AppTheme.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/colorPrimary</item>
        <item name="android:colorAccent">@color/colorAccent</item>
        <item name="android:textColorPrimary">@color/onSurface_dark</item>
        <item name="android:windowBackground">@color/surface_dark</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <!-- Calculator button styles - modern and minimal -->
    <style name="CalcKey" parent="@android:style/Widget.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/onSurface</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/bg_calc_button_normal</item>
        <item name="android:foreground">@drawable/calc_button_ripple</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:minWidth">42dp</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:elevation">1dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
    </style>

    <style name="CalcKeyPrimary" parent="CalcKey">
        <item name="android:background">@drawable/bg_calc_button_primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="CalcKeyWide" parent="CalcKey">
        <item name="android:layout_weight">2</item>
    </style>
</resources>
