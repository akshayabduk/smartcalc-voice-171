<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@color/surface">

    <org.example.app.VoiceSearchBar
        android:id="@+id/voiceSearchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true" />

    <LinearLayout
        android:id="@+id/layoutCalculatorKeypadContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/voiceSearchBar"
        android:layout_marginTop="8dp"
        android:orientation="vertical">
        <include
            layout="@layout/view_calculator_keypad"
            android:id="@+id/calculatorKeypad"
        />
    </LinearLayout>

    <!-- Minimal modern result box displaying numbers or expressions, styled -->
    <TextView
        android:id="@+id/resultBox"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_below="@id/layoutCalculatorKeypadContainer"
        android:layout_marginTop="12dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center_vertical|end"
        android:padding="20dp"
        android:text=""
        android:textColor="@color/onSurface"
        android:textSize="22sp"
        android:background="@drawable/bg_search_container"
        android:ellipsize="end"
        android:maxLines="2"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/onSurface"
        android:layout_centerInParent="true" />
</RelativeLayout>
