<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="?android:windowBackground">

    <!-- Voice Search Bar at the top -->
    <org.example.app.VoiceSearchBar
        android:id="@+id/voiceSearchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:importantForAccessibility="yes"
        android:contentDescription="@string/voice_search_content_desc" />

    <!-- Row: Result box, undo/redo buttons, and history button horizontally, directly below the search bar -->
    <LinearLayout
        android:id="@+id/resultHistoryRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/voiceSearchBar"
        android:layout_marginTop="12dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="1dp">

        <TextView
            android:id="@+id/resultBox"
            android:layout_width="0dp"
            android:layout_height="66dp"
            android:layout_weight="1"
            android:gravity="center_vertical|end"
            android:paddingStart="26dp"
            android:paddingEnd="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:text=""
            android:textColor="@color/onSurface"
            android:textSize="24sp"
            android:background="@drawable/bg_result_box"
            android:ellipsize="end"
            android:maxLines="2"
            android:fontFamily="sans-serif-medium"
            android:elevation="1dp"
            android:contentDescription="@string/result_box_content_desc"
            android:accessibilityLiveRegion="polite"
            android:importantForAccessibility="yes"/>

        <!-- Undo/Redo buttons container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="8dp">

            <ImageButton
                android:id="@+id/btnUndo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_calc_button_normal"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="@color/onSurface"
                android:contentDescription="@string/undo_button_desc"
                android:layout_marginEnd="4dp"
                android:padding="8dp"/>

            <ImageButton
                android:id="@+id/btnRedo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_calc_button_normal"
                android:src="@android:drawable/ic_menu_rotate"
                android:tint="@color/onSurface"
                android:contentDescription="@string/redo_button_desc"
                android:padding="8dp"/>
        </LinearLayout>

        <!-- Inline modern history button (icon) -->
        <ImageButton
            android:id="@+id/btnShowHistory"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_history"
            android:tint="@color/onSurface"
            android:background="@drawable/bg_calc_button_normal"
            android:foreground="@drawable/calc_button_ripple"
            android:contentDescription="@string/history_icon_content_desc"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:elevation="1dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutCalculatorKeypadContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/resultHistoryRow"
        android:layout_marginTop="8dp"
        android:orientation="vertical">
        <include
            layout="@layout/view_calculator_keypad"
            android:id="@+id/calculatorKeypad"
        />
    </LinearLayout>

    <!-- News Ticker below calculator keypad -->
    <HorizontalScrollView
        android:id="@+id/newsTickerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutCalculatorKeypadContainer"
        android:layout_marginTop="12dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="16dp"
        android:scrollbars="none"
        android:background="@drawable/bg_news_ticker"
        android:fillViewport="true">
        
        <TextView
            android:id="@+id/newsTickerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/onSurface"
            android:textSize="14sp"
            android:padding="8dp"
            android:singleLine="true"
            android:ellipsize="none"
            android:scrollHorizontally="true"
            android:focusable="true"
            android:clickable="true" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/onSurface"
        android:layout_centerInParent="true" />

    <!-- Overlay root for history drawer, initially GONE -->
    <FrameLayout
        android:id="@+id/historyDrawerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:background="#99000000">
    </FrameLayout>

</RelativeLayout>
