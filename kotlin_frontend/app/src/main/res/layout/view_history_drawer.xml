<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/historyDrawerRoot"
    android:layout_width="match_parent"
    android:layout_height="450dp"
    android:orientation="vertical"
    android:importantForAccessibility="yes"
    android:contentDescription="@string/history_drawer_content_desc"
    android:background="@color/historyBg"
    android:padding="0dp"
    android:elevation="8dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/historyBg"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="3dp"
        android:paddingTop="16dp"
        android:paddingBottom="4dp">

        <!-- Title and controls row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/historyTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/history_panel_title"
                android:textColor="@color/onSurface"
                android:textStyle="bold"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"/>

            <!-- Close (X) button, minimal modern icon style -->
            <ImageButton
                android:id="@+id/btnCloseHistory"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/onSurface"
                android:contentDescription="@string/close_history"
                android:layout_marginEnd="4dp"
                android:focusable="true"
                android:clickable="true" />

            <Button
                android:id="@+id/btnClearHistory"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/clear_history"
                android:background="@drawable/bg_calc_button_normal"
                android:textColor="@color/onSurface"
                android:textSize="14sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Favorites filter row -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchFavorites"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/filter_favorites"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:textColor="@color/onSurface" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/historyRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="8dp"
        android:paddingBottom="14dp"
        android:scrollbars="vertical"
        android:overScrollMode="ifContentScrolls" />
</LinearLayout>
